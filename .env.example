# ShopPilot Environment Configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# --- Application Environment -------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True

# --- Shop Identity -----------------------------------------------------
SHOP_NAME=ShopPilot
SHOP_TITLE=ShopPilot — مدیریت فروشگاه
SHOP_DESCRIPTION=پنل مدیریت هوشمند آنلاین‌شاپ

# --- Security (CHANGE THESE IN PRODUCTION!) ---------------------------
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
WTF_CSRF_SECRET_KEY=change-this-to-a-different-random-key-for-csrf

# --- Database ----------------------------------------------------------
DATABASE_URL=sqlite:///instance/shop_pilot.db

# --- Session Security --------------------------------------------------
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
REMEMBER_COOKIE_SECURE=False
REMEMBER_COOKIE_SAMESITE=Lax

# --- Login Security ----------------------------------------------------
LOGIN_RATE_LIMIT=5 per minute
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Password Security -------------------------------------------------
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=True
PASSWORD_REQUIRE_LOWER=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_REJECT_COMMON=True
PASSWORD_REJECT_DEFAULT=True

# --- Pagination --------------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# --- Timezone ----------------------------------------------------------
TIMEZONE=Asia/Tehran

# --- Default Administrator (first init only) ---------------------------
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- File Upload -------------------------------------------------------
MAX_CONTENT_LENGTH_MB=16
UPLOAD_FOLDER=instance/uploads